# Copy to .env (never committed). All optional on the web.
# Published site (web export with data/ and vendor/): required by the native app, which has no local server.
EXPO_PUBLIC_SITE_URL=
# Separate host for the KPI files only (overrides SITE_URL/data).
EXPO_PUBLIC_DATA_URL=
# Local price-check API (ml: uv run rea-ml serve). Local only: it returns individual DVF sales.
EXPO_PUBLIC_API_URL=http://localhost:8787
